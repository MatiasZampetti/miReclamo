PORT=3001

# Supabase: Settings -> API Keys -> Secret keys
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_...

# Anthropic: console.anthropic.com -> API keys
ANTHROPIC_API_KEY=sk-ant-...

# Twilio: Console -> Account -> API keys & tokens
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=xxxx
TWILIO_WHATSAPP_NUMBER=+14155238886

JWT_SECRET=min-32-caracteres-random
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# Origen permitido por CORS (de donde se sirve el dashboard)
WEB_URL=http://localhost:3000
# Modelo del chat: groq (gratis) o anthropic (pago). La clave del elegido es obligatoria.
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b
# Groq: chat y transcripcion de audios (plan gratuito en console.groq.com)
GROQ_API_KEY=gsk_tu_clave_de_groq
